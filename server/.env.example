# Copiar en el VPS como /opt/avala/landing/.env (fuera de app/, que se reemplaza en cada deploy).
# SMTP_PASS es una "contraseña de aplicación" de Google de la cuenta SMTP_USER
# (myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gerencia@avalagroup.net
SMTP_PASS=
MAIL_FROM=Web Avala Group <gerencia@avalagroup.net>
CONTACT_TO=info@avalagroup.net
LEAD_TO=ventas@avalagroup.net
# Copia oculta para que el remitente vea los mensajes en Recibidos (por defecto = SMTP_USER; "none" la desactiva)
# MAIL_BCC=gerencia@avalagroup.net
